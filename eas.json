{
  "cli": {
    "version": ">= 20.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {},
    "production-apk": {
      "extends": "production",
      "android": { "buildType": "apk" },
      "env": { "FORCE_ABI_FILTERS": "1" }
    }
  },
  "submit": {
    "production": {}
  }
}
