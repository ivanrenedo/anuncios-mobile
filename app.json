{
  "expo": {
    "name": "bolt-expo-nativewind",
    "slug": "bolt-expo-nativewind",
    "owner": "ivanrenedo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "marketeg",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.guslift.com",
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnable": "true",
      "package": "com.guslift.com",
      "googleServicesFile": "./google-services.json",
      "permissions": ["NOTIFICATIONS", "POST_NOTIFICATIONS"],
      "usesCleartextTraffic": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "@react-native-google-signin/google-signin",
      "./plugins/withJdk17",
      [
        "expo-notifications",
        {
          "color": "#1f6feb"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Market EG accede a tus fotos para añadirlas a tus anuncios.",
          "cameraPermission": "Market EG usa la cámara para que hagas fotos de tus anuncios."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ea50d3d5-8d29-4d8d-bda5-1ff2c88bc6c0"
      }
    }
  }
}
